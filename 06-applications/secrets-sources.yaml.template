# Where the externally supplied secrets come from.
#
# Copy to <env>/secrets-sources.yaml and fill in. That file is not committed:
# it names locations in your credential store, which are specific to your
# organisation even though they are not themselves secret.
#
# An entry is either a single reference, or a map of field name to reference
# when the secret is a JSON object. A value beginning with op:// is read with
# the 1Password CLI; anything else is used literally, so this file can be
# generated from another store.
#
# Leave an entry out and the secret is skipped: the ones marked optional in
# secrets.yaml are left empty, and the rest stop the run before it writes
# anything.

sources:
  # Pull credentials for the container registry behind the ECR cache.
  acr:
    username: "op://<VAULT>/<ITEM>/username"
    accessToken: "op://<VAULT>/<ITEM>/password"

  # The GitHub App ArgoCD authenticates as. The private key is base64.
  argocd_github_app:
    githubAppID: "op://<VAULT>/<ITEM>/app_id"
    githubAppInstallationID: "op://<VAULT>/<ITEM>/app_installation_id"
    githubAppPrivateKey: "op://<VAULT>/<ITEM>/app_private_key_b64"

  # Optional below this line; leave out what you do not use.
  # Docker Hub, for its pull-through cache rule. Same shape as acr.
  dockerhub:
    username: "op://<VAULT>/<ITEM>/username"
    accessToken: "op://<VAULT>/<ITEM>/pat"
  alertmanager_slack_webhook: "op://<VAULT>/<ITEM>/webhook-url"
  google_search: "op://<VAULT>/<ITEM>/api-key"
