#!/bin/bash
set -euo pipefail

#######################################
# Pre-commit hook
#######################################
#
# Scans staged changes for secrets, then format-checks any modified Terraform
# layer. Enable with: ./scripts/install-hooks.sh
#######################################

# Resolve from git: correct from .githooks/ and in a linked worktree.
REPO_ROOT="$(git rev-parse --show-toplevel)"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

echo -e "${BLUE}🔍 Running pre-commit checks...${NC}"

#######################################
# 1. Secrets in the staged diff
#######################################
SECRET_SCAN="${REPO_ROOT}/scripts/scan-secrets.sh"

if ! command -v gitleaks &>/dev/null; then
  echo -e "${YELLOW}⚠️  gitleaks not found, skipping secret scan (CI still enforces it)${NC}"
elif [[ ! -x "$SECRET_SCAN" ]]; then
  echo -e "${YELLOW}⚠️  scripts/scan-secrets.sh not found, skipping secret scan${NC}"
elif git diff --cached --quiet; then
  echo -e "${GREEN}✅ No staged changes to scan${NC}"
elif ! ( cd "$REPO_ROOT" && "$SECRET_SCAN" --staged ); then
  echo -e "${YELLOW}💡 To bypass (emergency only): git commit --no-verify${NC}"
  exit 1
fi

#######################################
# 2. Terraform formatting
#######################################
# Format only; CI validates the layers on the pull request.
STAGED_TF=$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '^[0-9]{2}-[^/]+/terraform/.*\.tf$' || true)

if [[ -z "$STAGED_TF" ]]; then
  echo -e "${GREEN}✅ No Terraform changes to check${NC}"
  exit 0
fi

if ! command -v terraform &>/dev/null; then
  echo -e "${YELLOW}⚠️  terraform not found, skipping format check${NC}"
  exit 0
fi

LAYER_DIRS=$(echo "$STAGED_TF" | sed -E 's#^([0-9]{2}-[^/]+)/.*#\1#' | sort -u)
FMT_FAILED=false

for layer_dir in $LAYER_DIRS; do
  echo -e "${BLUE}🔍 terraform fmt -check ${layer_dir}${NC}"
  if terraform -chdir="${REPO_ROOT}/${layer_dir}/terraform" fmt -check -recursive >/dev/null 2>&1; then
    echo -e "${GREEN}✅ ${layer_dir} is formatted${NC}"
  else
    echo -e "${RED}❌ ${layer_dir} is not formatted:${NC}"
    terraform -chdir="${REPO_ROOT}/${layer_dir}/terraform" fmt -check -recursive 2>&1 \
      | sed 's/^/    /' || true
    FMT_FAILED=true
  fi
done

if [[ "$FMT_FAILED" == true ]]; then
  echo -e "${RED}❌ Pre-commit checks failed${NC}"
  echo -e "${YELLOW}💡 Fix with: terraform -chdir=<layer>/terraform fmt -recursive${NC}"
  exit 1
fi

echo -e "${GREEN}✅ All pre-commit checks passed${NC}"
exit 0
